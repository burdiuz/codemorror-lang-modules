    "url": "https://github.com/burdiuz/codemirror-lang-glsl.git"
  },
  "bugs": {
    "url": "https://github.com/burdiuz/codemirror-lang-glsl/issues"
  },
  "homepage": "https://github.com/burdiuz/codemirror-lang-glsl#readme",
  "scripts": {
