// ICU MessageFormat — https://unicode-org.github.io/icu/userguide/format_parse/messages/
//
// A message is a run of literal text interleaved with `{...}` arguments.
// Arguments can be simple (`{name, type, style}`) or complex selectors
// (`{name, plural, ...}` / `{name, selectordinal, ...}` / `{name, select, ...}`)
// whose branches each hold a full nested Message — hence the grammar is
// naturally recursive rather than a flat token stream.
//
// Whitespace is only insignificant *inside* argument syntax (around commas,
// keywords, `=N`, etc). Inside message text — including a plural/select
// branch's own content — it is meaningful and must be preserved literally.
// `@skip { ws }` is scoped to the argument-syntax rules only; `Message`
// itself (and everything it's built from) stays outside that scope so
// plain-text runs are never silently stripped.

@top Program { Message }

@skip {} {
  Message { part* }
  part { Text | PoundSign | EscapedApos | QuotedLiteral | Argument }

  // Case branches re-enter the no-skip zone that `Message` lives in (their
  // nested content must not have whitespace silently skipped), but still
  // allow whitespace between the selector keyword and the opening brace —
  // a single non-repeating spot, so it can't create the shift/reduce
  // ambiguity a `(ws? X)+` repetition would.
  PluralCase { (ExactValue | pluralKeyword) ws? "{" Message "}" }
  SelectCase { (ExactValue | identifier | kw<"other">) ws? "{" Message "}" }
}

@skip { ws } {
  Argument {
    "{" ArgName argBody? "}"
  }

  argBody { "," (PluralArg | SelectArg | SimpleArg) }

  ArgName { number | identifier }

  SimpleArg { ArgType ("," ArgStyle)? }
  ArgStyle { argStyleText }

  // ICU spec: `argNameOrNumber "," "plural" "," pluralStyle` — the comma after
  // the keyword is required, distinct from the one `argBody` already consumed
  // before it.
  PluralArg {
    (kw<"plural"> | kw<"selectordinal">) "," OffsetClause? PluralCase+
  }
  OffsetClause { kw<"offset"> ":" number }
  pluralKeyword { kw<"zero"> | kw<"one"> | kw<"two"> | kw<"few"> | kw<"many"> | kw<"other"> }

  SelectArg { kw<"select"> "," SelectCase+ }

  ExactValue { "=" number }

  // Built-in simple argument types only (no generic `identifier` fallback):
  // an open fallback here would collide with `plural`/`selectordinal`/`select`
  // at the `argBody` dispatch point — both are reachable as a bare identifier
  // via `@extend`, and the parser can't tell "unknown simple type" from "this
  // is actually a selector keyword" with one token of lookahead.
  ArgType {
    kw<"number"> | kw<"date"> | kw<"time"> | kw<"duration"> |
    kw<"spellout"> | kw<"ordinal">
  }
}

@tokens {
  // Any run of plain message text — everything that isn't the start of an
  // argument, a quote, or a pound sign.
  Text { ![{}'#]+ }

  // `#` is only semantically special inside a plural/selectordinal branch
  // (where it's replaced by the formatted number), but it's tokenized
  // uniformly everywhere for simplicity — a v1 accepted limitation, same
  // spirit as the flat preprocessor token in the GLSL/SkSL grammars.
  PoundSign { "#" }

  // `''` is the ICU escape for a literal apostrophe.
  EscapedApos { "''" }

  // `'...'` quotes a run of literal text, including otherwise-special
  // characters like `{`, `}`, `#`. A doubled `''` inside still means a
  // literal apostrophe. Requires at least one inner unit so it doesn't
  // overlap with EscapedApos on plain `''`.
  QuotedLiteral { "'" (![']|"''")+ "'" }

  number { $[0-9]+ }
  identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }
  ws { $[ \t\r\n]+ }

  // Free-form style text for a simple argument (e.g. `short`, `::yyyy.MM.dd`).
  argStyleText { ![{}]+ }

  "{" "}" "," ":" "="

  @precedence { ws, argStyleText }
}

// ICU's keywords (`plural`, `select`, `date`, `other`, `one`, etc.) are only
// special by position — argument-type and selector-branch names come from the
// same open identifier namespace as argument names (`{plural, number}` is a
// valid message where the argument happens to be named "plural"). So these
// use `@extend` (contextual keyword, GLR-resolved), not `@specialize`
// (reserved-forever keyword) — see js-codemirror-package's lezer skill,
// grammar-directives.md's `@specialize` vs `@extend` table.
kw<term> { @extend[@name={term}] <identifier, term> }

@external propSource icuHighlighting from "./highlight"

@detectDelim
